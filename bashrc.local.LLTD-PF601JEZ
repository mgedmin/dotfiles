# for git bash
export MSYS=winsymlinks:nativestrict
# for WSL (unnecessary, if you apt install wslu, wslview becomes the default
# x-www-browser alternative)
##export BROWSER=wslview
# for both
export LC_VIM_BACKGROUND=dark

export ADM_USER=adm-gedminas

if [ -z "$SSH_AUTH_SOCK" ] && [ -x /usr/bin/keychain ]; then
    eval "$(keychain --quiet --eval)"
fi

if [ -n "$PS1" ]; then
    if ! test -e /tmp/krb5cc_$UID; then
        # shellcheck disable=SC2016
        printf 'No Kerberos ticket.  You may want to run\n\n  kinit $ADM_USER\n'
    else
        expiration_time=$(klist | awk '$5 == "krbtgt/CORP.DRAEGER.GLOBAL@CORP.DRAEGER.GLOBAL" { print $3 " " $4 }')
        expiration_time_t=$(date --date="$expiration_time" +%s)
        now_time_t=$(date +%s)
        if [[ $expiration_time_t -lt $now_time_t ]]; then
            # shellcheck disable=SC2016
            printf 'Kerberos TGT expired.  You may want to run\n\n  kinit $ADM_USER\n'
        fi
    fi
    if ! test -e "$XDG_RUNTIME_DIR"/bashrc-forwarding-check-done; then
        forwarding_status=$(powershell.exe 'Get-NetIPInterface -ifAlias "vEthernet (WSL (Hyper-V firewall))","vEthernet (Default Switch)" | Format-Table InterfaceAlias, AddressFamily, Forwarding')
        if grep -q Disabled <<<"$forwarding_status"; then
            printf "%s\n" "$forwarding_status"
        else
            touch "$XDG_RUNTIME_DIR"/bashrc-forwarding-check-done
        fi
    fi
fi
