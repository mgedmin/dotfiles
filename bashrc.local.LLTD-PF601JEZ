# for git bash
export MSYS=winsymlinks:nativestrict
# for WSL (unnecessary, if you apt install wslu, wslview becomes the default
# x-www-browser alternative)
##export BROWSER=wslview
# for both
export LC_VIM_BACKGROUND=dark

export ADM_USER=adm-gedminas

if [ -z "$SSH_AUTH_SOCK" ] && [ -x /usr/bin/keychain ]; then
    eval "$(keychain --quiet --eval)"
fi

if [ -n "$PS1" ]; then
    if ! test -e /tmp/krb5cc_$UID; then
        # shellcheck disable=SC2016
        printf 'You may want to run\n  kinit $ADM_USER\n\n'
    fi
fi
